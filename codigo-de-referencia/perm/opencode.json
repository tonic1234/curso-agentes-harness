{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": { "*": "allow", "*.env": "deny" },
    "edit": { "*": "allow", "migrations/**": "deny" },
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run lint": "allow",
      "git status": "allow",
      "git push *": "ask",
      "rm -rf *": "deny"
    }
  }
}
